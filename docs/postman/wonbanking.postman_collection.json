  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountNo",
      "value": "1002-345-112233"
    },
    {
      "key": "newAccountNo",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
