    {
      "name": "Day 2 — JWT · 요청 추적 · Actuator (t3 ~ t5)",
      "description": "t3 부터는 '로그인' 을 먼저 실행한다. 토큰이 컬렉션 변수 token 에 저장되고 모든 요청에 자동으로 붙는다.",
      "item": [
        {
          "name": "로그인 (yeonji / 1234) → 토큰 저장",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/login",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"loginId\": \"yeonji\", \"password\": \"1234\"}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 받은 토큰을 변수에 저장 → 컬렉션의 모든 요청이 Authorization: Bearer {{token}} 으로 보낸다",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "회원가입 (201 — 0원 입출금 계좌가 함께 생긴다. 같은 아이디로 다시 보내면 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/api/auth/signup",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"loginId\": \"minsu\", \"password\": \"1234\", \"name\": \"김민수\"}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "로그인 실패 (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
