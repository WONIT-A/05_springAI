{
  "info": {
    "name": "WONIT - Transaction API 테스트",
    "description": "Spring Boot TransactionController 테스트 모음. baseUrl 기본값은 http://localhost:8080입니다. TransactionResponse의 실제 필드명에 따라 데이터 조건 검증 스크립트의 후보 필드명을 조정할 수 있습니다. 서버가 실행 중인지 확인한 뒤 Collection Runner로 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 전체 거래 조회",
      "description": "GET /transactions — 데이터가 있으면 거래 목록을 반환하고, 데이터가 없으면 빈 배열을 반환해야 합니다.",
      "item": [
        {
          "name": "정상 - 전체 거래 목록 조회",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions",
            "description": "정상 케이스: 전체 거래 목록을 JSON 배열로 반환하는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 상태 코드가 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"응답 본문은 JSON 배열\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"배열의 각 항목은 객체\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "    data.forEach(function (item) {",
                  "        pm.expect(item).to.be.an(\"object\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "오류 - 존재하지 않는 경로",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions/does-not-exist",
            "description": "경로 오류 확인. 서버의 별도 오류 페이지/포괄 매핑 설정이 있다면 예상 상태 코드가 달라질 수 있습니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"존재하지 않는 경로는 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 유형 또는 메모 검색 - /transactions/select",
      "description": "category와 memo는 선택 파라미터입니다. 둘 다 유효하지 않으면 400이어야 합니다. 두 값을 함께 넣으면 서비스 메서드 이름상 OR 조건을 기대합니다.",
      "item": [
        {
          "name": "정상 - category만 입력",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions/select?category=%EC%8B%9D%EB%B9%84",
            "description": "예시 category=식비. DB에 해당 유형이 없어도 정상 응답은 200과 빈 배열입니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 상태 코드가 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"응답 본문은 JSON 배열\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"배열의 각 항목은 객체\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "    data.forEach(function (item) {",
                  "        pm.expect(item).to.be.an(\"object\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"category 검색 조건 확인 (응답에 관련 필드가 있을 때)\", function () {",
                  "    const rows = pm.response.json();",
                  "    const keyword = (pm.request.url.query.get(\"category\") || \"\").trim().toLowerCase();",
                  "    if (!keyword || rows.length === 0) return;",
                  "",
                  "    const keys = [\"category\", \"transactionCategory\", \"categoryName\"];",
                  "    const key = keys.find(function (candidate) {",
                  "        return rows.some(function (row) {",
                  "            return Object.prototype.hasOwnProperty.call(row, candidate);",
                  "        });",
                  "    });",
                  "    if (!key) {",
                  "        console.warn(\"응답에서 category 필드를 찾지 못해 데이터 조건 검증을 생략했습니다. DTO 필드명에 맞게 테스트를 조정하세요.\");",
                  "        return;",
                  "    }",
                  "    rows.forEach(function (row) {",
                  "        pm.expect(String(row[key]).toLowerCase()).to.include(keyword);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "정상 - memo만 입력",
          "request": {
