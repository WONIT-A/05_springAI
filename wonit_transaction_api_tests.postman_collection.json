                  "pm.test(\"memo 검색 조건 확인 (응답에 관련 필드가 있을 때)\", function () {",
                  "    const rows = pm.response.json();",
                  "    const keyword = (pm.request.url.query.get(\"memo\") || \"\").trim().toLowerCase();",
