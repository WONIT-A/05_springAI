        {
          "name": "정상 - category와 memo 모두 입력(OR)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions/select?category=%EC%8B%9D%EB%B9%84&memo=%EC%A0%90%EC%8B%AC",
            "description": "category 또는 memo 중 하나에 일치하는 거래가 반환되는지 확인합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 상태 코드가 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"응답 본문은 JSON 배열\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"배열의 각 항목은 객체\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "    data.forEach(function (item) {",
                  "        pm.expect(item).to.be.an(\"object\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"category 또는 memo 중 하나와 일치 (응답에 관련 필드가 있을 때)\", function () {",
                  "    const rows = pm.response.json();",
                  "    if (rows.length === 0) return;",
                  "",
                  "    const category = (pm.request.url.query.get(\"category\") || \"\").trim().toLowerCase();",
                  "    const memo = (pm.request.url.query.get(\"memo\") || \"\").trim().toLowerCase();",
                  "    const categoryKeys = [\"category\", \"transactionCategory\", \"categoryName\"];",
                  "    const memoKeys = [\"memo\", \"transactionMemo\", \"description\", \"content\"];",
                  "    const categoryKey = categoryKeys.find(function (key) {",
                  "        return rows.some(function (row) { return Object.prototype.hasOwnProperty.call(row, key); });",
                  "    });",
                  "    const memoKey = memoKeys.find(function (key) {",
                  "        return rows.some(function (row) { return Object.prototype.hasOwnProperty.call(row, key); });",
                  "    });",
                  "",
                  "    if (!categoryKey && !memoKey) {",
                  "        console.warn(\"응답에서 category/memo 필드를 찾지 못해 데이터 조건 검증을 생략했습니다. DTO 필드명에 맞게 테스트를 조정하세요.\");",
                  "        return;",
                  "    }",
                  "",
                  "    rows.forEach(function (row) {",
                  "        const categoryMatches = category && categoryKey",
                  "            ? String(row[categoryKey] ?? \"\").toLowerCase().includes(category)",
                  "            : false;",
                  "        const memoMatches = memo && memoKey",
                  "            ? String(row[memoKey] ?? \"\").toLowerCase().includes(memo)",
                  "            : false;",
                  "        pm.expect(categoryMatches || memoMatches).to.eql(true);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
