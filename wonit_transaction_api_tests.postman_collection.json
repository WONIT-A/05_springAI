    {
      "name": "3. 금액 범위 검색 - /transactions/select2",
      "description": "minAmount와 maxAmount는 long 필수 파라미터입니다. minAmount가 maxAmount보다 크면 컨트롤러에서 400을 반환합니다.",
      "item": [
        {
          "name": "정상 - 50,000원~100,000원",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/transactions/select2?minAmount=50000&maxAmount=100000",
            "description": "계획 예시 범위. 반환된 금액 필드가 확인되면 모든 항목이 범위 안에 있는지 검증합니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 상태 코드가 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"응답 본문은 JSON 배열\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"배열의 각 항목은 객체\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an(\"array\");",
                  "    data.forEach(function (item) {",
                  "        pm.expect(item).to.be.an(\"object\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"모든 거래 금액이 요청한 범위에 포함 (금액 필드를 찾을 수 있을 때)\", function () {",
                  "    const rows = pm.response.json();",
                  "    const minAmount = Number(pm.request.url.query.get(\"minAmount\"));",
                  "    const maxAmount = Number(pm.request.url.query.get(\"maxAmount\"));",
                  "    if (rows.length === 0) return;",
                  "",
